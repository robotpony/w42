# Security headers that only work as real HTTP headers (the theme's
# security.html covers CSP and referrer as meta tags). Guarded so a server
# without mod_headers serves the site instead of a 500.
<IfModule mod_headers.c>
    # No includeSubDomains/preload: every subdomain would have to be HTTPS-only.
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
</IfModule>

# Hugo's 404 page (the theme's workshop text adventure).
ErrorDocument 404 /404.html

# Recipes moved to the cookbook site (2026-10-17).
RedirectMatch 301 ^/(pages/)?food(/.*)?$ https://bruce-loves-to-cook.ca/
